<?xml version="1.0"?>
<package format="3">
  <name>gpd_ros</name>
  <version>0.0.0</version>
  <description>ROS 2 wrapper for Grasp Pose Detection (GPD).</description>
  <maintainer email="s6bewing@uni-bonn.de">ur5</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS dependencies required by the active CMakeLists.txt / node headers -->
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>gpd_ros_messages</depend>

  <!-- Launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Native PCL/OpenCV/Eigen/libgpd are installed by the system/native layer;
       libgpd itself has no rosdep key in this project and is intentionally
       handled by environment/install_gpd.sh. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
